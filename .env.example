# Polar AccessLink: App registrieren unter https://admin.polaraccesslink.com
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Muss exakt der bei Polar eingetragenen Redirect-URL entsprechen
POLAR_REDIRECT_URI=http://localhost:8000/polar/callback
# Wird beim Anlegen des Webhooks von Polar geliefert (optional)
POLAR_WEBHOOK_SECRET=
# Speicherort für Datenbank und FIT-Dateien
DATA_DIR=./data
