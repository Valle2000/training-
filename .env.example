# Nur serverseitig verwendet – niemals committen
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Zugangscode für die KI-Funktionen, sobald die App online ist
APP_ACCESS_CODE=
# Öffentliche Adresse der App (für OAuth-Rückleitungen), z. B. https://training.vercel.app
APP_URL=

# Polar AccessLink: https://admin.polaraccesslink.com  (Redirect-URL: <APP_URL>/api/connect)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Concept2 Logbook (ErgData): https://log.concept2.com/developers  (Redirect-URL: <APP_URL>/api/connect)
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
# Wahoo Cloud API: https://developers.wahooligan.com  (Redirect-URL: <APP_URL>/api/connect)
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Online-Abgleich und Anmeldung (dasselbe Supabase-Projekt wie SkiWax; Project Settings → API).
# Der anon key ist öffentlich und darf in den Browser. Einmal supabase/training.sql im SQL Editor ausführen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
